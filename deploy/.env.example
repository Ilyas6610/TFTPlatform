# Copy to deploy/.env and fill in. deploy/.env is gitignored.

# Required.
POSTGRES_PASSWORD=change-me

# The backend containers run as this user so they can read the Riot key file
# (deploy/.secrets/riot-api-key.txt) while it stays owner-only. Set to the
# key file owner's ids: `id -u` and `id -g`.
APP_UID=1000
APP_GID=1000

# Optional (defaults shown).
# POSTGRES_USER=tft
# POSTGRES_DB=tft
# HTTP_PORT=80
# IMAGE_PREFIX=tft-platform
# IMAGE_TAG=latest
# FETCH_ASSETS=1                  # 0 skips baking game icons into the frontend image
# SETDATA_SYNC_INTERVAL=6h
# RIOT_APP_RATE_LIMIT_PER_SEC=20  # raise both for a production Riot key
# RIOT_APP_RATE_LIMIT_PER_2MIN=100
# How the key is shared between riotsync, the API's page-triggered lookups,
# "Load whole set" loads and an unused reserve (percent, at most 100 in all):
# RIOT_BUDGET_SPLIT=sync:40,ondemand:30,backfill:20,reserve:10
# API_MEM_LIMIT=1g                # container memory caps
# FRONTEND_MEM_LIMIT=256m
# RIOTSYNC_MEM_LIMIT=512m
# POSTGRES_MEM_LIMIT=2g

# riotsync background service (only with --profile ingest). Replaces the old
# `ingest` shell-loop service: when upgrading, start with --remove-orphans so
# the old container doesn't keep running, and rename INGEST_SEED_INTERVAL /
# INGEST_CRAWL_INTERVAL to the durations below (6h, 5m; not seconds).
# INGEST_PLATFORMS=na1            # space- or comma-separated, e.g. "na1 euw1 kr"
# RIOTSYNC_SEED_INTERVAL=6h       # leaderboard re-seed
# RIOTSYNC_CRAWL_INTERVAL=5m      # one bounded crawl batch
# RIOTSYNC_NAMES_INTERVAL=10m     # Riot ID backfill
# RIOTSYNC_AGGREGATE_INTERVAL=1h  # precomputed meta stats recompute
# RIOTSYNC_RATE_LIMIT_PER_SEC=    # default: riotsync's share of RIOT_BUDGET_SPLIT;
# RIOTSYNC_RATE_LIMIT_PER_2MIN=   # set only to go below it (above it fails startup)

# Shared stats cache (redis service). Required: set a password (letters and
# digits only, it goes into a URL); compose refuses to start without one.
REDIS_PASSWORD=
# STATS_CACHE_TTL=10m
# REDIS_MAXMEMORY=128mb

# Database backups (backup service: a pg_dump every BACKUP_INTERVAL_SECONDS).
# BACKUP_DIR must be writable by APP_UID:APP_GID; keep a copy off the host.
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
# BACKUP_INTERVAL_SECONDS=86400
