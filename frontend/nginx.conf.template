server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API requests go to the backend. Leaderboard and profile requests can
    # wait on Riot (refreshes are capped at 10s server-side).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Content-hashed build output and game icons never change in place.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location /tft/ {
        expires 7d;
        add_header Cache-Control "public";
    }
    # ...except the icon manifest, which changes when icons are refreshed.
    location = /tft/manifest.json {
        add_header Cache-Control "no-cache";
    }

    # Single-page app: unknown paths serve index.html (never cached, so new
    # builds are picked up).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
